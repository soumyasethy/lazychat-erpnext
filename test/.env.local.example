# Copy to test/.env.local and fill in values; .env.local is gitignored.
#
# Two auth modes are supported. Pick ONE.
#
# A) Username/password (simplest — works against any Frappe site that allows
#    cookie auth). The script logs in and uses the sid cookie. CSRF is sent
#    when present in the boot payload, otherwise omitted.
FRAPPE_URL=http://localhost:8000
FRAPPE_USER=Administrator
FRAPPE_PWD=***REMOVED***
#
# B) API key + secret (preferred for CI / scripted runs — survives logout, no
#    CSRF concerns). Generate one at /app/user/<your-user> → API Access →
#    Generate Keys. Setting these makes A) ignored.
# FRAPPE_KEY=
# FRAPPE_SECRET=
#
# Optional: scope the run.
#   - QUICK_PROBE=1 hits only the 9 tools the user reported failing.
#   - SLOW_TOOLS=1 also runs aggregate/run_report/etc against the largest
#     doctypes; off by default to keep per-tool latency readable.
# QUICK_PROBE=0
# SLOW_TOOLS=0
