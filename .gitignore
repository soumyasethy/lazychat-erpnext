scripts/deploy.env
scripts/bench-root.local

# NOTE: lazychat_erpnext/public/lazychat_dist/ (the pre-built chat-ui SPA) is
# COMMITTED so `bench get-app ... --branch main` and Frappe Cloud marketplace
# installs ship a working panel out of the box. Regenerate it with
# scripts/build-lazychat-dist.sh after changing the chat-ui, then
# `git add -A lazychat_erpnext/public/lazychat_dist/` (the -A picks up the
# content-hashed chunks that were renamed/removed).

# Python build artifacts
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE
.vscode/
.idea/

# Smoke test runner is copied into the bench at runtime, not committed
lazychat_erpnext/_smoke.py

# Layer-1 test harness: secrets + per-run output, not committed
test/.env.local
test/results/*.json
test/evidence/



# macOS
.DS_Store
.cursor/
