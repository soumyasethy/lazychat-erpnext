# Copy this file to deploy.env in the same directory and edit values.
# deploy.env is intended to stay local (add to .gitignore if you commit secrets).
#
# Alternative to BENCH_ROOT here: put a single line (absolute path) in scripts/bench-root.local (gitignored).

# Required: absolute path to YOUR frappe-bench root (folder that contains ./apps and ./sites).
# Replace the example path below — copy from Finder: Go → Go to Folder → drag folder into Terminal.
# Leave invalid / placeholder until you set a real path, or use bench-root.local instead.
BENCH_ROOT=/path/to/your/frappe-bench

# Site name for migrate + clear-cache (deploy-local.sh runs both when set).
# bench --site <site> migrate — creates/updates doctypes (e.g. LLM Provider Header), applies LLM Provider / LLM Model JSON + install hooks.
# bench build --app lazychat_erpnext — bundles llm_setup_shared.js, llm_provider_form.js, llm_model_form.js, llm_setup.css.
# bench --site <site> clear-cache — after DB is reachable (fixes stale Desk metadata; skip if frappe@localhost / DB errors).
# Leave unset to skip migrate and clear-cache (build still runs).
DEPLOY_SITE=erp.local

# Optional: set to 1 to skip rsync (e.g. when apps/lazychat_erpnext is already a symlink to this repo).
# SKIP_SYNC=1

# Recommended for day-to-day work: skip migrate (rsync + build + clear-cache only). Full migrate when DocTypes/seeds change.
SKIP_MIGRATE=1
# Single full run: SKIP_MIGRATE=0 ./scripts/deploy-local.sh   or   ./scripts/deploy-local.sh --full

# Optional: set to 1 to skip clear-cache even when DEPLOY_SITE is set.
# SKIP_CACHE=1

# After UI/JS/CSS changes, hooks.py adds ?v=version.mtime — reload Python workers to refresh that string.
# deploy-local.sh: if RESTART_BENCH is unset, Linux defaults to 1; macOS defaults to 0 (no Supervisor frappe: group).
# Override explicitly:
# RESTART_BENCH=1   # Linux/production with Supervisor — run bench restart after deploy
# RESTART_BENCH=0   # macOS dev — skip; use Shift+Reload or restart `bench start` manually

# Optional: after deploy, restart bench in background (stops existing honcho/bench dev listeners on :8000/:9000/:11000/:13000 first).
# START_BENCH_AFTER_DEPLOY=1
# Lighter: only start if ports are free (does not kill existing processes).
# START_BENCH_IF_DOWN=1
